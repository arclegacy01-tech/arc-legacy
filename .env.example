# Server (local: server/.env — Vercel: Project Environment Variables)
PORT=5050
# Local: mongodb://127.0.0.1:27017/arc_legacy
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/arc_legacy?retryWrites=true&w=majority
MONGODB_URI=
JWT_SECRET=change-me-in-production
CLIENT_URL=http://localhost:5173
# Comma-separated extra CORS origins (e.g. https://your-app.vercel.app)
CORS_ORIGINS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=arc-legacy

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin seed
SEED_ADMIN_EMAIL=admin@arclegacy.in
SEED_ADMIN_PASSWORD=Admin@12345

# Client — VITE_* in client/.env OR server/.env (Vite merges both in dev/build)
# VITE_API_URL=/api

# Firebase (Google sign-in) — https://console.firebase.google.com
# 1. Create project → Authentication → Sign-in method → enable Google
# 2. Project settings → Your apps → Web app → copy config into client/.env
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (server) — Project settings → Service accounts → Generate new private key
# Paste into server/.env (keep private key on one line with \n for newlines)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
