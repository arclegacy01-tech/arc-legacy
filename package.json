{
  "name": "arc-legacy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
